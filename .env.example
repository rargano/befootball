# Copy this file to .env. Never commit actual keys.
APP_ENV=development

# News APIs (choose providers you have licensed)
NEWS_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=

# Sports data APIs (fixtures, results, standings)
API_FOOTBALL_KEY=
SPORTMONKS_API_KEY=
FOOTBALL_DATA_API_KEY=

# X content is rendered with official embeds in the static prototype.
# No token is required unless you later switch to the official X API.

# Optional AI processing
OPENAI_API_KEY=

# Source refresh policy
NEWS_REFRESH_SECONDS=900
SPORTS_REFRESH_SECONDS=300
RUMOR_REFRESH_SECONDS=600
ENABLE_EXTERNAL_FETCH=false
